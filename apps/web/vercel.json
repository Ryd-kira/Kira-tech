{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kira-tech-api.vercel.app/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://kira-tech-api.vercel.app/api/v1/public/sitemap.xml" },
    { "source": "/((?!assets/|favicon.svg|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
