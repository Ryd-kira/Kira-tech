NODE_ENV=development
PORT=4000
# Neon : URL poolée (application) et URL directe (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# Origines autorisées, séparées par des virgules (ex. https://www.votre-domaine.bj)
CORS_ORIGINS="http://localhost:5173"
APP_URL="http://localhost:5173"
SESSION_TTL_HOURS=12
# Render : 1 proxy devant l'API
TRUST_PROXY=0
LOG_LEVEL=info
# Cloudinary (photos produits) : Settings > API Keys. Le secret reste côté serveur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
